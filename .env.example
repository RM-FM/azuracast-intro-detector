# Copy to .env (never commit it). bin/setup.sh writes it for you.
# AzuraCast API key of the detector's account; the Sweepers plugin's setup creates it.
AZURACAST_API_KEY=
# Token the Sweepers plugin uses for the management API; setup creates it.
INTRO_DETECTOR_API_TOKEN=
# Optional: a Runpod key here becomes the server's shared key on the first start.
RUNPOD_API_KEY=
